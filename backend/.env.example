DJANGO_SECRET_KEY=generatesecretkeyhere
ENV=development

# For local development (SQLite)
SQLITE_NAME=db.sqlite3

# For production (MySQL)
MYSQL_NAME=your_db_name
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Blockchain (ContestPrize smart contract) - see docs/blockchain-integration.md
# Leave RPC/address empty to turn the blockchain features off.
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/<your-key>
BLOCKCHAIN_CHAIN_ID=11155111
CONTEST_CONTRACT_ADDRESS=0x...
# Wallet of the server = owner of the contract. It pays the gas and the prizes.
# NEVER commit this key and keep only a small amount on it.
BLOCKCHAIN_OWNER_PRIVATE_KEY=
BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io
