# Copy to .env (never commit .env). Loaded automatically by forge.

# RPC of the network you deploy to (Infura / Alchemy / any Sepolia RPC)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<your-key>

# Deployer key. Leave empty to use an encrypted keystore instead:
#   cast wallet import deployer --interactive
#   forge script ... --account deployer
PRIVATE_KEY=

# Optional: ownership is transferred to this address after the deploy.
# Must be the address of the backend wallet (BLOCKCHAIN_OWNER_PRIVATE_KEY in backend/.env).
CONTRACT_OWNER=

# For `--verify` (source code verification on Etherscan)
ETHERSCAN_API_KEY=
